{
  "$comment": "Umpire removed from default-features due to fmt link errors",
  "name": "axom",
  "version-string": "develop",
  "description": "Host-config generator for Axom TPLs",
  "homepage": "https://github.com/llnl/axom",
  "license": "BSD-3-Clause",
  "supports": "!uwp",
  "default-features": [
    "conduit",
    "lua",
    "mfem",
    "opencascade",
    "openmp",
    "raja"
  ],
  "features": {
    "conduit": {
      "description": "conduit functionality for axom",
      "dependencies": [
        "conduit"
      ]
    },
    "lua": {
      "description": "lua functionality for axom",
      "dependencies": [
        "lua"
      ]
    },
    "mfem": {
      "description": "mfem functionality for axom",
      "dependencies": [
        "mfem"
      ]
    },
    "opencascade": {
      "description": "opencascade functionality for axom",
      "dependencies": [
        {
          "name": "opencascade",
          "default-features": false
        }
      ]
    },
    "openmp": {
      "description": "openmp functionality for axom",
      "dependencies": [
        {
          "name": "raja",
          "features": [
            "openmp"
          ]
        }
      ]
    },
    "python": {
      "description": "python functionality for axom",
      "dependencies": [
        {
          "name": "conduit",
          "features": [
            "python"
          ]
        },
        "nanobind",
        "python3",
        {
          "name": "vcpkg-get-python-packages",
          "host": true
        }
      ]
    },
    "raja": {
      "description": "raja functionality for axom",
      "dependencies": [
        "raja"
      ]
    },
    "umpire": {
      "description": "umpire functionality for axom",
      "dependencies": [
        "umpire"
      ]
    }
  }
}
