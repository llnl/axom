{
  "name": "conduit",
  "version": "0.9.5",
  "homepage": "https://github.com/llnl/conduit",
  "description": "Simplified Data Exchange for HPC Simulations",
  "dependencies": [
    {
      "name": "hdf5",
      "features": ["tools"]
    }, 
    "blt",
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }    
  ],
  "features": {
    "python": {
      "description": "python functionality for conduit",
      "dependencies": [
        "python3",
        {
          "name": "vcpkg-get-python-packages",
          "host": true
        }
      ]
    }
  },
  "supports": "!uwp"
}
