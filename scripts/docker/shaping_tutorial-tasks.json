{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open login shell",
      "type": "shell",
      "command": "/bin/bash",
      "args": [
        "-il"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "showReuseMessage": false,
        "clear": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
